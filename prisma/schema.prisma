generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  VALIDATING
  PROCESSING
  DISCOVERABLE
  VALIDATION_FAILED
  PROCESSING_FAILED
}

model Listing {
  id             String        @id @default(uuid())
  platform       String        @default("amazon")
  sellerId       String
  sku            String
  inventorySku   String
  inventory      InventoryItem @relation(fields: [inventorySku], references: [sku])
  submissionId   String        @unique
  status         ListingStatus @default(SUBMITTED)
  payload        Json
  platformFields Json          @default("{}")
  webhookUrl     String?
  orderItems     OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([platform, sellerId, sku])
  @@index([platform])
  @@index([sku])
  @@index([inventorySku])
  @@index([sellerId])
  @@index([status])
  @@map("listings")
}

model InventoryItem {
  id        String    @id @default(uuid())
  sku       String    @unique
  quantity  Int
  listings  Listing[]
  orderItems OrderItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sku])
  @@map("inventory")
}

model Order {
  id                  String      @id @default(uuid())
  platform            String
  sellerId            String
  marketplaceOrderId  String
  status              String
  payload             Json        @default("{}")
  orderItems          OrderItem[]
  orderedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([platform, sellerId, marketplaceOrderId])
  @@index([platform])
  @@index([sellerId])
  @@index([status])
  @@index([orderedAt])
  @@map("orders")
}

model OrderItem {
  id                     String         @id @default(uuid())
  orderId                String
  order                  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku                    String
  listingId              String?
  listing                Listing?       @relation(fields: [listingId], references: [id])
  inventorySku           String
  inventory              InventoryItem  @relation(fields: [inventorySku], references: [sku])
  quantity               Int
  unitPrice              Float?
  payload                Json           @default("{}")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([orderId])
  @@index([sku])
  @@index([listingId])
  @@index([inventorySku])
  @@map("order_items")
}

model MarketplaceFieldMapping {
  id              String   @id @default(uuid())
  platform        String   @unique
  marketplaceName String
  fields          Json
  mapping         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([marketplaceName])
  @@map("marketplace_field_mappings")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
